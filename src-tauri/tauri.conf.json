{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "录播宝",
  "version": "0.1.0",
  "identifier": "io.github.xsong13.lubobao",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "录播宝",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "Song",
    "copyright": "Copyright © 2026 Song. Released under the MIT License.",
    "license": "MIT",
    "category": "Video",
    "shortDescription": "开播自动录，不用再蹲直播",
    "longDescription": "录播宝是一个直播录制桌面应用：添加直播间后自动检测开播并调用 FFmpeg 录制。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "video"
      }
    }
  }
}
