{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "录播宝",
  "version": "0.2.0",
  "identifier": "com.xiaofany.lubobao",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "录播宝",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Song",
    "copyright": "Copyright © 2026 Song. Released under the MIT License.",
    "license": "MIT",
    "category": "Video",
    "shortDescription": "开播自动录，不用再蹲直播",
    "longDescription": "录播宝是一个直播录制桌面应用：添加直播间后自动检测开播并调用 FFmpeg 录制。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "video"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMzVFMTYzRDBEMjU2MDIKUldRQ1Z0TFFZK0UxUURzVWR2VU4rM2I5Y2RiS3ZNazJNK05mNyt6eTg4dEpGQzFFWE1YVHhFaDkK",
      "endpoints": [
        "https://xiaofany.com/api/update/lubobao/tauri/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/seansongx/lubobao/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
